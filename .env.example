# Minecraft server
TREEBOT_SERVER_HOST=insanesmp.net
TREEBOT_SERVER_PORT=25565
TREEBOT_MC_VERSION=1.21.11

# Account - REQUIRED. Do NOT put the real password in GitHub.
TREEBOT_USERNAME=your_username
TREEBOT_PASSWORD=your_password

# Farming stand block
TREEBOT_STAND_X=0
TREEBOT_STAND_Y=64
